# Generate TWO different values with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Empty values intentionally prevent startup. Never commit the populated .env.
ATZE_OPERATOR_TOKEN=
ATZE_REVIEWER_TOKEN=
ATZE_DB_PATH=data/atze.db
# Optional; empty means DB parent / objects. This directory is created locally.
ATZE_STORAGE_ROOT=
# Optional existing operator-provisioned directory; no automatic mounting/creation.
ATZE_SD_ROOT=
# operational is the default, not a production readiness certificate. No fake backends.
ATZE_MODE=operational
# Optional for startup; REQUIRED for a separately running Challenge Worker and any new task acceptance.
# Generate a third different token. Missing configuration never enables an in-process fallback.
ATZE_CHALLENGE_TOKEN=
# Optional trusted JSON provider configuration. Empty = no providers, no model egress.
ATZE_AI_CONFIG=
# Endpoint credentials use explicitly configured ATZE_AI_TOKEN_<NAME> environment keys.
# Never reuse platform operator/reviewer/challenge credentials.

# Optional Bright Data OAuth access token; NEVER an API key/query URL. Blank means disabled.
ATZE_BRIGHTDATA_OAUTH_TOKEN=

# Optional shared device-fleet credential for POST /api/telemetry/ingest (>=32 characters).
# Blank = ingestion disabled fail-closed (403). Device identity is declared per batch via sensor registry.
# Never reuse operator/reviewer/challenge credentials; devices send this one token as Bearer.
ATZE_TELEMETRY_TOKEN=
