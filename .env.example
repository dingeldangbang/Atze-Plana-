# Generate TWO different values with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Empty values intentionally prevent startup. Never commit the populated .env.
ATZE_OPERATOR_TOKEN=
ATZE_REVIEWER_TOKEN=
ATZE_DB_PATH=data/atze.db
# Optional; empty means DB parent / objects. This directory is created locally.
ATZE_STORAGE_ROOT=
# Optional existing operator-provisioned directory; no automatic mounting/creation.
ATZE_SD_ROOT=
# operational is the default, not a production readiness certificate. No fake backends.
ATZE_MODE=operational
# Optional for startup; REQUIRED for a separately running Challenge Worker and any new task acceptance.
# Generate a third different token. Missing configuration never enables an in-process fallback.
ATZE_CHALLENGE_TOKEN=
