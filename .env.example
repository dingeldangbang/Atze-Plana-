# Generate TWO different values with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Empty values intentionally prevent startup. Never commit the populated .env.
ATZE_OPERATOR_TOKEN=
ATZE_REVIEWER_TOKEN=
ATZE_DB_PATH=data/atze.db
# Optional; empty means DB parent / objects. This directory is created locally.
ATZE_STORAGE_ROOT=
# Optional existing operator-provisioned directory; no automatic mounting/creation.
ATZE_SD_ROOT=
